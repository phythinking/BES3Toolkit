# When you see this .tcshrc file in you HOME directory, it means that
# most probably you had use an auto-setup BOSS scripts written by
# Dr. ZHOU Xiang (xiangzhou@whu.edu.cn), a BESIII member. Don't panic! 
# Your original .tcshrc might be changed as a backup file hidden in HOME.
# If you has any question, you can ask the person who provided this code,
# OR contact with Dr. Zhou directly. Please Enjoy it!
set autolist
set listmax=20
set ignoreeof
set history=100
set savehist=100
set prompt='%B\[%n@%m %c]$ ' 

set autologout=0

alias ls				 'ls --color'
alias root         'root -l'
alias lt           'ls -l -t | tac'
alias v            'vi'
alias workf        'cd /workfs2/bes/USERID/'
alias besf         'cd /besfs5/users/USERID'
alias scra         'cd /scratchfs/bes/USERID'
alias batch        'cd /ihepbatch/bes/USERID'
alias q            'hep_q -u USERID'
alias Q            'hep_q -Q'
alias t            'hep_q -t | grep "USERID"'
alias n            'hep_q -u USERID | cat -n | less'
#alias PrintThemAll 'tcsh /workfs2/bes/zhoux/BES3Toolkit/PrintThemAll/PrintThemAll'
#alias PrintIt      'tcsh /workfs2/bes/zhoux/BES3Toolkit/PrintIt/PrintIt'
#alias chi2FoM      'tcsh /workfs2/bes/zhoux/BES3Toolkit/chi2FoM/chi2FoM'
alias setupBOSS    '/workfs2/bes/zhoux/BES3Toolkit/setupBOSS/installBOSS'
alias installRobot '/workfs2/bes/zhoux/BES3Toolkit/WallE//installRobot'
alias compileAlg   '/workfs2/bes/zhoux/BES3Toolkit/compileAlg/compileAlg'
alias creatAlg     '/workfs2/bes/zhoux/BES3Toolkit/creatAlg/creatAlg'

alias SSL5 'hep_container shell SL5'
alias SSL6 'hep_container shell SL6'
setenv PATH /cvmfs/container.ihep.ac.cn/bin:${PATH}
setenv PATH $HOME/bin/bossbin:${PATH}
setenv PATH /afs/ihep.ac.cn/soft/common/sysgroup/hep_job/bin:${PATH}

